# Configuration contract only.
# Spring Boot does not automatically load this file.
# Never place real passwords or secrets in this committed example.

DB_URL=jdbc:mysql://localhost:3306/drss
DB_USERNAME=drss_app
DB_PASSWORD=replace_with_local_database_password

SERVER_PORT=8080

MAIL_USERNAME=replace_with_gmail_address
MAIL_APP_PASSWORD=replace_with_gmail_app_password
MAIL_FROM=replace_with_sender_gmail_address

JWT_SECRET=replace_with_at_least_32_random_bytes
OTP_HMAC_SECRET=replace_with_a_different_32_byte_secret
RATE_LIMIT_HMAC_SECRET=replace_with_a_third_distinct_32_byte_secret

# Cloudinary server-side credentials. Never expose API secret to JavaScript.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
CLOUDINARY_FOLDER=drss/local/dat

APP_BASE_URL=http://localhost:8080
AUTH_COOKIE_SECURE=false